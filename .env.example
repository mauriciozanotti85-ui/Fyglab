PORT=3000
# URL pública de la app (necesaria para Mercado Pago: redirecciones y webhook)
PUBLIC_URL=https://tu-dominio.com
# Obligatorio en producción: cadena larga y aleatoria
JWT_SECRET=
NODE_ENV=production

# Cuenta del entrenador (se crea la primera vez que arranca la app)
TRAINER_NAME=Coach
TRAINER_EMAIL=coach@fitcoach.app
TRAINER_PASSWORD=cambiar-esta-clave

# Mercado Pago (si queda vacío, los pagos funcionan en modo demo)
MP_ACCESS_TOKEN=
# true = usa el checkout de prueba (sandbox) con credenciales de test
MP_SANDBOX=false

# Ruta del archivo SQLite y de las fotos de progreso
# DB_PATH=./data/fitcoach.db
# UPLOAD_DIR=./data/uploads

# ---- Recordatorios ----
# Horario de envío (hora local de Argentina) y cada cuántos minutos se revisa
REMINDER_HOURS=9-21
REMINDER_INTERVAL_MIN=30
# REMINDERS_SCHEDULER=off   # desactiva el envío automático

# Email por SMTP (Gmail, Brevo, Mailgun, SendGrid, el de tu hosting…). Vacío = modo simulado
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FitCoach <avisos@tu-dominio.com>"

# WhatsApp Business Cloud API (Meta). Vacío = modo simulado
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE_LANG=es_AR
# Nombre de la plantilla aprobada en Meta para cada aviso (sin plantilla, ese aviso no sale por WhatsApp)
WA_TEMPLATE_EXPIRING=
WA_TEMPLATE_EXPIRED=
WA_TEMPLATE_INACTIVE=
WA_TEMPLATE_CHECKIN=
WA_TEMPLATE_MESSAGE=
# Plantilla del botón "Probar WhatsApp" (hello_world viene aprobada por defecto)
WA_TEMPLATE_TEST=hello_world
